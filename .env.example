# Server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Time zone of the dashboard owner: "today", "overdue" and day math use it
TZ=Europe/Rome
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgres://command:command@localhost:5432/command

# Dashboard owner: used to filter the company Gantt and shown in the UI
USER_NAME=Marco
USER_ROLE=Automation & software, Sistec
USER_GITHUB=marco-v

# Auth (JWT). Generate the secret with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT=10
# true behind HTTPS (production): the refresh cookie is then sent over TLS only
COOKIE_SECURE=false
